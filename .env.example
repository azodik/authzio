# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Authzio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Match the URL you open in the browser (Herd: https://authzio.test · Docker: http://localhost:8080).
APP_URL=https://authzio.test
# Docker Compose only — force absolute links to APP_URL when the container port differs from the published host port.
# APP_FORCE_URL=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# Release identity (optional locally; Docker/CI bake these into the image).
# SemVer source of truth is the VERSION file when these are unset.
# AUTHZIO_VERSION=1.2.0
# AUTHZIO_BUILD=217
# AUTHZIO_COMMIT=82af91c

# -----------------------------------------------------------------------------
# Logging / Nightwatch
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
# Self-host / Docker / VPS default. Laravel Cloud: laravel-cloud-socket,nightwatch
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional: https://nightwatch.laravel.com — add nightwatch to LOG_STACK and run nightwatch:agent
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=authzio
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# Postgres transaction pooler (PgBouncer / Neon / RDS Proxy / Supabase):
# Point DB_HOST at the pooler, set DB_POOLED=true, and set a direct endpoint for migrations.
# DB_POOLED=true
# DB_DIRECT_HOST=127.0.0.1
# DB_DIRECT_PORT=5432
# DB_DIRECT_DATABASE="${DB_DATABASE}"
# DB_DIRECT_USERNAME="${DB_USERNAME}"
# DB_DIRECT_PASSWORD="${DB_PASSWORD}"
# DB_DIRECT_SSLMODE=prefer
# Or: DB_DIRECT_URL=pgsql://user:pass@direct-host:5432/authzio

# -----------------------------------------------------------------------------
# Session / Sanctum
# -----------------------------------------------------------------------------
# NEVER use SESSION_DRIVER=cookie on Laravel Cloud — cookie-sized sessions cause HTTP 431.
# Prefer: database (default) or redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave null for host-only cookies. Avoid ".authzio.com" unless you need subdomain sharing.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=authzio.test,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Console (platform) social login — leave empty to disable
# -----------------------------------------------------------------------------
# Google Cloud OAuth client → redirect: {APP_URL}/console/auth/google/callback
CONSOLE_GOOGLE_CLIENT_ID=
CONSOLE_GOOGLE_CLIENT_SECRET=
# GitHub OAuth App → callback: {APP_URL}/console/auth/github/callback
CONSOLE_GITHUB_CLIENT_ID=
CONSOLE_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Queue / cache / filesystem
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Local: public disk (`php artisan storage:link`). Cloud/S3: set by platform or use s3.
FILESYSTEM_DISK=local
# Optional override for logos / avatars (defaults to `public` locally, else FILESYSTEM_DISK).
# AUTHZIO_ASSETS_DISK=assets

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@authzio.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS (optional — S3 / assets)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Authzio — passwords / MFA
# -----------------------------------------------------------------------------
AUTHZIO_PASSWORD_MIN_LENGTH=12
AUTHZIO_PASSWORD_REQUIRE_MIXED_CASE=true
AUTHZIO_PASSWORD_REQUIRE_NUMBERS=true
AUTHZIO_PASSWORD_REQUIRE_SYMBOLS=true
AUTHZIO_MFA_ENABLED=true
AUTHZIO_MFA_REQUIRED_FOR_ADMINS=false
AUTHZIO_MFA_ISSUER="${APP_NAME}"

# -----------------------------------------------------------------------------
# Authzio — billing / MAU
# -----------------------------------------------------------------------------
# Self-host / OSS default. Authzio Cloud sets this to true.
AUTHZIO_BILLING_ENABLED=false
AUTHZIO_BILLING_CURRENCY=USD
AUTHZIO_MAU_TIMEZONE=UTC
# AUTHZIO_USAGE_ALERT_THRESHOLDS=80,90,100

# -----------------------------------------------------------------------------
# Authzio — domains
# -----------------------------------------------------------------------------
# Org subdomains: acme.AUTHZIO_DOMAIN_ROOT (local: authzio.test · cloud: authzio.com)
AUTHZIO_DOMAIN_ROOT=authzio.test
# Enforce DNS TXT on custom domain Verify when Cloudflare SaaS is off (local/dev).
AUTHZIO_DOMAIN_DNS_VERIFY=true
# Shared CNAME target for custom domains (Cloudflare for SaaS front door).
AUTHZIO_CUSTOM_DOMAIN_CNAME_TARGET=customers.authzio.com

# Cloudflare for SaaS — custom hostnames + TLS (Authzio Cloud).
# Token needs Zone → SSL and Certificates → Edit (Custom Hostnames).
CLOUDFLARE_CUSTOM_HOSTNAMES_ENABLED=false
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CUSTOM_HOSTNAME_SSL_METHOD=txt

# -----------------------------------------------------------------------------
# Dodo Payments — https://docs.dodopayments.com
# -----------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PAYMENTS_RETURN_URL="${APP_URL}/console/{organization_id}/billing"
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=

# -----------------------------------------------------------------------------
# Marketing / SEO / ads (optional — scripts load only when set)
# -----------------------------------------------------------------------------
MARKETING_URL="${APP_URL}"
MARKETING_TWITTER="@azodikhq"
MARKETING_LINKEDIN="https://www.linkedin.com/company/azodik"
MARKETING_INSTAGRAM="https://www.instagram.com/azodikhq"
# GOOGLE_SITE_VERIFICATION=
# FACEBOOK_DOMAIN_VERIFICATION=
# BING_SITE_VERIFICATION=
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# META_PIXEL_ID=
# LINKEDIN_PARTNER_ID=
# REDDIT_PIXEL_ID=
