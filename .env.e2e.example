# -----------------------------------------------------------------------------
# Playwright E2E template → copied to .env / .env.e2e by: php artisan authzio:e2e-prepare
# Existing DODO_* (and related) keys in .env are preserved across prepare.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Authzio
# Dedicated Playwright environment — unlocks __e2e/* helpers and relaxes rate limits.
APP_ENV=e2e
APP_KEY=base64:2fl+KtvkdphvQyE8m4YZqKzF2F8xQxN1yR3pL0wV8aE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=8
NIGHTWATCH_ENABLED=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (SQLite file for isolated E2E)
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

# -----------------------------------------------------------------------------
# Session / Sanctum
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# Queue / cache / filesystem
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail → Mailpit (docker compose -f docker-compose.e2e.yml)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@authzio.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Authzio — passwords / MFA
# -----------------------------------------------------------------------------
AUTHZIO_PASSWORD_MIN_LENGTH=12
AUTHZIO_PASSWORD_REQUIRE_MIXED_CASE=true
AUTHZIO_PASSWORD_REQUIRE_NUMBERS=true
AUTHZIO_PASSWORD_REQUIRE_SYMBOLS=true
AUTHZIO_MFA_ENABLED=true

# -----------------------------------------------------------------------------
# Authzio — billing / domains
# -----------------------------------------------------------------------------
AUTHZIO_BILLING_ENABLED=true
AUTHZIO_DOMAIN_ROOT=authzio.test
AUTHZIO_DOMAIN_DNS_VERIFY=false
CLOUDFLARE_CUSTOM_HOSTNAMES_ENABLED=false

# -----------------------------------------------------------------------------
# Dodo Payments (real test mode) — https://docs.dodopayments.com
# Fill these in .env; authzio:e2e-prepare preserves them.
# -----------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PAYMENTS_RETURN_URL="${APP_URL}/console/{organization_id}/billing"
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=

# -----------------------------------------------------------------------------
# Marketing
# -----------------------------------------------------------------------------
MARKETING_URL="${APP_URL}"
